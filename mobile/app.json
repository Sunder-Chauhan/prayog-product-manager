{
  "expo": {
    "owner": "sunderexpoapps-team",
    "name": "Prayog Decor Manager",
    "slug": "prayog-decor-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.prayogdecor.manager"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.prayogdecor.manager"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "prayogdecor",
    "plugins": [
      "expo-router",
      "expo-image-picker"
    ],
    "extra": {
      "eas": {
        "projectId": "af7b0176-cb2a-4e7f-b12a-00f7e909b01b"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/af7b0176-cb2a-4e7f-b12a-00f7e909b01b",
      "checkAutomatically": "ON_LOAD"
    }
  }
}
